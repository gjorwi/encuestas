# URL del servidor de ControlPeso (Express, Render).
# En Vercel: Settings → Environment Variables → NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=https://apicontrolpeso.onrender.com

# NOTA: la contraparte en el servidor (Render) es SURVEY_BASE_URL, que debe
# apuntar al dominio de ESTA app para que el link del correo sea
# {SURVEY_BASE_URL}/responder?t=<token>.
